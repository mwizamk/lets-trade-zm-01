        <script type="text/javascript">
            $(document).ready(function(){
                // Manage Menu
                $('.dropdown-menu').each(function(i, item){
                    var itemCount = 0;
                    $('.dropdown-item a', item).each(function(idx, it){
                        itemCount++;
                    });
                    if(itemCount <= 0) {
                        $(item).closest('.nav-item').hide();
                    }
                });

                Storage.prototype.setObj = function(key, value) {
                    if(typeof value === "object") {
                        window.sessionStorage.setItem(key, JSON.stringify(value));
                    } else {
                        window.sessionStorage.setItem(key, value);
                    }
                };
                Storage.prototype.getObj = function(key) {
                    var value = window.sessionStorage.getItem(key), result = null;
                    try {
                        result = JSON.parse(value);
                    } catch(Exception) {
                        result = value;
                    }
                    return result;
                };

                if(!window.preventLoadPrograms) {
                    var programElement = jQuery('select[name="program_id"],select#program_id,select.program_id');
                    window.sessionStorage.setObj(programElement.prop('name'), programElement.val());
                    $.post(baseUrl + 'programme/getPrograms.json', {}, function (programs) {
                        function updatePrograms(school_id) {
                            var options = window.options || [];
                            var data = [];
                            for (var i in programs) {
                                if ((Array.isArray(school_id) && school_id.indexOf(programs[i].Program.school_id) >= 0)
                                    || (programs[i].Program.school_id === school_id)) {
                                    data.push({
                                        id: programs[i].Program.id,
                                        text: programs[i].Program.program_description
                                    });
                                }
                            }
                            programElement.empty().select2({
                                data: options.concat(data)
                            }).val(window.sessionStorage.getObj(programElement.prop('name'))).trigger('change.select2');
                        }

                        jQuery('select[name="school_id"],select#school_id,select.school_id').on('change', function (event) {
                            updatePrograms(jQuery(this).val());
                        }).change();
                    });
                }

                // Save state
                if(window.saveState) {
                    jQuery('select').on('change', function (event) {
                        window.sessionStorage.setObj(event.target.name, jQuery(event.target).val());
                    }).each(function (idx, item) {
                        jQuery(item).val(window.sessionStorage.getObj(item.name));
                    }).select2();
                }

                jQuery(window).on('resize', function(){
                    var height = jQuery('nav.navbar').height();
                    jQuery('.sidebar').css({top: height});
                    jQuery('.topSpace').css({height: height});
                }).resize();
            });
        </script>
    

