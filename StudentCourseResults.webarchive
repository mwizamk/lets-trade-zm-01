_"399a-6092dc60b5e7c-gzip"_Accept-EncodingUbytes“/0rs_NSMutableDictionary£rt3\NSDictionary_application/javascript“/0wx_NSHTTPURLResponse£yz3_NSHTTPURLResponse]NSURLResponse␀␀␀␀$␀)␀2␀7␀I␀L␀b␀d␀ç␀ì␀Æ␀–␀Ú␀ı<CehkçØ≤¥∂∏∫ºæ¿¬√≈«…À“⁄ÊËÍÏ#.7=@IRTV]ep~ÄÇÑÜàäåéêíîñò¶®™¨Æ∞≤¥∂∏∫ºæ¿¬œ⁄Ë!0;DIN\uä™¬«‡␀Ë!7;Hafz~í␀␀␀␀␀␀␀␀␀␀␀␀␀{␀␀␀␀␀␀␀␀␀␀␀␀␀␀†‘defgOM0/**
 * Author: Mwape Daka
 * Date: 14/11/2017
 *
 */

var DashboardChart = function(container) {
    this.getOptions = function(){
        return {
                chart: {
                    renderTo: this.container,
                        plotBackgroundColor: null,
                        plotBorderWidth: null,
                        plotShadow: false,
                        zoomType: 'x',
                        panning: true,
                        panKey: 'shift'
                },
                credits: {
                    enabled: false
                },
                legend: {
                    enabled: true
                },
                lang: {
                    thousandsSep: ','
                },
                colors: ['#2f7ed8', '#0d233a', '#337700', '#910000', '#1aadce', '#492970', '#f28f43', '#77a1e5', '#c42525', '#339911'],
                    plotOptions: {
                column: {
                    pointPadding: 0.2,
                        borderWidth: 0,
                        dataLabels: {
                        enabled: true
                    }
                },
                bar: {
                    pointPadding: 0.2,
                        borderWidth: 0,
                        dataLabels: {
                        enabled: true
                    }
                },
                pie: {
                    allowPointSelect: true,
                        cursor: 'pointer',
                        dataLabels: {
                        enabled: true,
                            format: '<b>{point.name}</b>: {point.y:,.0f}'
                    },
                    showInLegend: true
                }
            }
        }
    };

    this._buildFilterText = function(filterIds, prefix) {
        var resultArray = [];
        for(var i in filterIds) {
            resultArray.push(window.sessionStorage.getItem(prefix + filterIds[i]));
        }
        return resultArray.join(', ');
    };

    this.renderRegistrationBySchool = function(container, ayear, school, programClass, category) {
        var params = {ayear: ayear, bySchool: true, program_class_id: programClass, category_id: category};
        container = (!!container) ? container : this.container;
        if(!!school)
            params.school = school;

        var levels = this._buildFilterText(programClass, 'level');
        var cats = this._buildFilterText(category, 'cat');

        jQuery.post(baseUrl + 'reports/getStatistics.json', params,  function(result) {
            var schools = {};
            var statuses = {};
            var data = {};

            for (i in result) {
                statuses[result[i][0].status] = true;
                schools[result[i].School.school_abbreviation] = true;
                if(!data[result[i].School.school_abbreviation]) {
                    data[result[i].School.school_abbreviation] = {}
                }
                data[result[i].School.school_abbreviation][result[i][0].status] = parseFloat(result[i][0].total);
            }
            series = [];
            for(school in schools) {
                var serie = {};
                for(status in statuses) {
                    if(!serie['name']) {
                        serie['name'] = school;
                        serie['data'] = [];
                    }
                    serie['data'].push((!!data[school][status]) ? data[school][status] : 0);
                }
                series.push(serie);
            }
            var categories = [];
            for(i in statuses){
                if(statuses.hasOwnProperty(i)){
                    categories.push(i);
                }
            }
            window.chart = Highcharts.chart(container, {
                chart: {
                    type: 'column'
                },
                title: {
                    text: 'Registration Statistics by School - ' + ayear + ' Academic Year'
                },
                subtitle: {
                    text: 'Program Level: ' + levels + '<br /> Category: ' + cats
                },
                xAxis: {
                    categories: categories,
                    crosshair: true
                },
                yAxis: {
                    min: 0,
                    title: {
                        text: 'Number of Students'
                    }
                },
                tooltip: {
                    headerFormat: '<span style="font-size:10px">{point.key}</span><table style="background-color:#ffffff;">',
                    pointFormat: '<tr><td style="color:{series.color};padding:0;text-align:right;">{series.name}: </td>' +
                    '<td style="padding:0"><b>{point.y:.0f}</b></td></tr>',
                    footerFormat: '</table>',
                    shared: true,
                    useHTML: true
                },
                series: series
            });
        });
    };

    this.renderRegistrationBySponsor = function(container, ayear, school, programClass, category){
        var params = {ayear: ayear, bySponsor: true, program_class_id: programClass, category_id: category};
        container = (!!container) ? container : this.container;
        if(!!school)
            params.school = school;

        var levels = this._buildFilterText(programClass, 'level');
        var cats = this._buildFilterText(category, 'cat');

        jQuery.post(baseUrl + 'reports/getStatistics.json', params,  function(result) {
            var sponsors = {};
            var statuses = {};
            var data = {};
            var categories = [];

            for (i in result) {
                statuses[result[i][0].status] = true;
                sponsors[result[i].Sponsor.sponsor_description] = true;
                if(!data[result[i].Sponsor.sponsor_description]) {
                    data[result[i].Sponsor.sponsor_description] = {}
                }
                data[result[i].Sponsor.sponsor_description][result[i][0].status] = parseFloat(result[i][0].total);
            }
            series = [];
            for(sponsor in sponsors) {
                var serie = {};
                for(status in statuses) {
                    if(!serie['name']) {
                        serie['name'] = sponsor;
                        serie['data'] = [];
                    }
                    serie['data'].push((!!data[sponsor][status]) ? data[sponsor][status] : 0);
                }
                series.push(serie);
            }
            for(i in statuses){
                if(statuses.hasOwnProperty(i)){
                    categories.push(i);
                }
            }

            window.chart = Highcharts.chart(container, {
                chart: {
                    type: 'column'
                },
                title: {
                    text: 'Registration Statistics by Sponsor - ' + ayear + ' Academic Year'
                },
                subtitle: {
                    text: 'Program Level: ' + levels + '<br /> Category: ' + cats
                },
                xAxis: {
                    categories: categories,
                    crosshair: true
                },
                yAxis: {
                    min: 0,
                    title: {
                        text: 'Number of Students'
                    }
                },
                tooltip: {
                    formatter: function(){
                        var html = '<table style="background-color:#ffffff;">';
                        var total = 0;
                        for(i in this.points) {
                            html += '<tr><td style="color:' + this.points[i].series.color + ';padding:0;text-align:right;">' + this.points[i].series.name + ': </td>' +
                                '<td style="padding:0"><b> ' + Highcharts.numberFormat(this.points[i].y, 0) + '</b></td></tr>';
                            total += this.points[i].y;
                        }

                        html = '<span style="font-weight:bold">' + this.points[0].key + '<br />Total: ' + Highcharts.numberFormat(total, 0) + '</span>' + html + '</table>';
                        return html;
                    },
                    shared: true,
                    useHTML: true
                },
                series: series
            });
        });
    };

    this.renderRegistration = function(container, ayear, school, programClass, category){
        var params = {ayear: ayear, program_class_id: programClass, category_id: category};
        container = (!!container) ? container : this.container;
        if(!!school)
            params.school = school;

        var levels = this._buildFilterText(programClass, 'level');
        var cats = this._buildFilterText(category, 'cat');

        jQuery.post(baseUrl + 'reports/getStatistics.json', params,  function(result){

            var pieData = [];
            for(i in result){
                pieData.push({name: result[i][0].status, y: parseFloat(result[i][0].total)});
            }

            window.chart = Highcharts.chart(container, {
                chart: {
                    type: 'pie'
                },
                title: {
                    text: 'Registration Statistics for ' + ayear + ' Academic Year'
                },
                subtitle: {
                    text: 'Program Level: ' + levels + '<br /> Category: ' + cats
                },
                tooltip: {
                    pointFormat: '{series.name}: <b>{point.percentage:.1f}%</b>'
                },
                series: [{
                    name: 'Students',
                    colorByPoint: true,
                    data: pieData
                }]
            });
        });
    };

    this.renderFinance = function(container, ayear, school, programClass, category){
        var params = {ayear: ayear, finance: true, program_class_id: programClass, category_id: category};
        container = (!!container) ? container : this.container;
        if(!!school)
            params.school = school;

        var levels = this._buildFilterText(programClass, 'level');
        var cats = this._buildFilterText(category, 'cat');

        jQuery.post(baseUrl + 'reports/getStatistics.json', params,  function(result) {

            var categories = ['(< 37.5)', '37.5% - 62.5%', '62.5% - 87.5%', '87.5% - 100%', '> 100%'];
            var data = [0, 0, 0, 0, 0];

            for(i in result) {
                var percentage = parseFloat(result[i][0].percentage);

                if (percentage >= 0 && percentage < 0.375) {
                    data[0] += parseInt(result[i][0].number);
                } else if (percentage >= 0.375 && percentage < 0.625) {
                    data[1] += parseInt(result[i][0].number);
                } else if (percentage >= 0.625 && percentage < 0.875) {
                    data[2] += parseInt(result[i][0].number);
                } else if (percentage >= 0.875 && percentage <= 1) {
                    data[3] += parseInt(result[i][0].number);
                } else if (percentage > 1) {
                    data[4] += parseInt(result[i][0].number);
                }
            }

            window.chart = Highcharts.chart(container, {
                chart: {
                    type: 'bar'
                },
                title: {
                    text: ayear + ' Student Payments - % of Tuition fees paid'
                },
                subtitle: {
                    text: 'Program Level: ' + levels + '<br /> Category: ' + cats
                },
                xAxis: {
                    labels: {
                        format: '{value}'
                    },
                    categories: categories,
                    title: {
                        text: 'Percentage Paid'
                    }
                },
                yAxis: {
                    startOnTick: true,
                    endOnTick: false,
                    maxPadding: 0.35,
                    title: {
                        text: 'Number of Students'
                    }
                },
                tooltip: {
                    formatter: function(){
                        var total = 0;
                        for(i in this.point.series.yData){
                            total += this.point.series.yData[i];
                        }
                        var s = '<b>' + this.point.series.name + '</b><br />';
                        s += Highcharts.numberFormat(this.point.y, 0) + ' Students (' + Math.round(((this.point.y / total) * 100), 1) + '%)';
                        return s;
                    },
                    shared: false
                },
                series: [{
                    data: data,
                    lineColor: Highcharts.getOptions().colors[1],
                    color: Highcharts.getOptions().colors[3],
                    fillOpacity: 0.5,
                    name: 'Number of Students',
                    marker: {
                        enabled: false
                    },
                    threshold: null
                }]
            });
        });
    };

    this.renderGraduationByComment = function(container, ayear, school, programClass, category){
        var params = {ayear: ayear, byGradComment: true, program_class_id: programClass, category_id: category};
        container = (!!container) ? container : this.container;
        if(!!school)
            params.school = school;

        var levels = this._buildFilterText(programClass, 'level');
        var cats = this._buildFilterText(category, 'cat');

        jQuery.post(baseUrl + 'reports/getStatistics.json', params,  function(result) {
            var items = {};
            var comments = {};
            var data = {};
            var prop, byProp = '';

            for (i in result) {
                prop = (!!result[i]['Program']) ? result[i]['Program']['program_abbrev'] : result[i]['School']['school_abbreviation'];
                byProp = (!!result[i]['Program']) ? 'by Programme' : 'by School';

                    comments[result[i].Comment.comment_descr] = true;
                items[prop] = true;
                if(!data[prop]) {
                    data[prop] = {}
                }
                data[prop][result[i].Comment.comment_descr] = parseFloat(result[i][0].total);
            }
            series = [];
            for(idx in items) {
                var serie = {};
                for(status in comments) {
                    if(!serie['name']) {
                        serie['name'] = idx;
                        serie['data'] = [];
                    }
                    serie['data'].push((!!data[idx][status]) ? data[idx][status] : 0);
                }
                series.push(serie);
            }
            var categories = [];
            for(i in comments){
                if(comments.hasOwnProperty(i)){
                    categories.push(i);
                }
            }
            window.chart = Highcharts.chart(container, {
                chart: {
                    type: 'column'
                },
                title: {
                    text: ayear + ' Graduation Comment Distribution ' + byProp
                },
                subtitle: {
                    text: 'Program Level: ' + levels + '<br /> Category: ' + cats
                },
                xAxis: {
                    categories: categories,
                    crosshair: true
                },
                yAxis: {
                    min: 0,
                    title: {
                        text: 'Number of Students'
                    }
                },
                tooltip: {
                    headerFormat: '<span style="font-size:10px">{point.key}</span><table style="background-color:#ffffff;">',
                    pointFormat: '<tr><td style="color:{series.color};padding:0;text-align:right;">{series.name}: </td>' +
                    '<td style="padding:0"><b>{point.y:.0f}</b></td></tr>',
                    footerFormat: '</table>',
                    shared: true,
                    useHTML: true
                },
                series: series
            });
        });
    };

    this.renderRegistrationByProgram = function(container, ayear, school, programClass, category){
        var params = {ayear: ayear, byProgram: true, program_class_id: programClass, category_id: category};
        container = (!!container) ? container : this.container;
        if(!!school)
            params.school = school;

        var levels = this._buildFilterText(programClass, 'level');
        var cats = this._buildFilterText(category, 'cat');

        jQuery.post(baseUrl + 'reports/getStatistics.json', params,  function(result) {

            var programs = {};
            var statuses = {};
            var data = {};

            for (i in result) {
                statuses[result[i][0].status] = true;
                programs[result[i].Program.program_abbrev] = true;
                if(!data[result[i].Program.program_abbrev]) {
                    data[result[i].Program.program_abbrev] = {}
                }
                data[result[i].Program.program_abbrev][result[i][0].status] = parseFloat(result[i][0].total);
            }
            series = [];
            for(p in programs) {
                var serie = {};
                for(status in statuses) {
                    if(!serie['name']) {
                        serie['name'] = p;
                        serie['data'] = [];
                    }
                    serie['data'].push((!!data[p][status]) ? data[p][status] : 0);
                }
                series.push(serie);
            }
            var categories = [];
            for(i in statuses){
                if(statuses.hasOwnProperty(i)){
                    categories.push(i);
                }
            }
            window.chart = Highcharts.chart(container, {
                chart: {
                    type: 'column'
                },
                title: {
                    text: 'Registration Statistics by Programme - ' + ayear + ' Academic Year'
                },
                subtitle: {
                    text: 'Program Level: ' + levels + '<br /> Category: ' + cats
                },
                xAxis: {
                    categories: categories,
                    crosshair: true
                },
                yAxis: {
                    min: 0,
                    title: {
                        text: 'Number of Students'
                    }
                },
                tooltip: {
                    headerFormat: '<span style="font-size:10px">{point.key}</span><table style="background-color:#ffffff;">',
                    pointFormat: '<tr><td style="color:{series.color};padding:0;text-align:right;">{series.name}: </td>' +
                    '<td style="padding:0"><b>{point.y:.0f}</b></td></tr>',
                    footerFormat: '</table>',
                    shared: true,
                    useHTML: true
                },
                series: series
            });
        });
    };

    this.container = container;
    Highcharts.setOptions(this.getOptions());
