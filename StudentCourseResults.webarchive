Oôtx/* css Zen Garden submission  - 'Use It or Lose It', by Paul Tilchin, http://www.cyusion.com/ */
/* css released under Creative Commons License - http://creativecommons.org/licenses/by-nc-sa/1.0/  */
/* All associated graphics copyright 2005, Paul Tilchin */
/*October 15th, 2005*/

/* IMPORTANT */
/* This design is not a template. You may not reproduce it elsewhere without the 
   designer's written permission. However, feel free to study the CSS and use 
   techniques you learn from it elsewhere. ***/


/*body { 
        color:#555555;
        background: white;
        margin: 0 0 0 0;
        padding: 0 0 0 0;
        font-family:"Arial", "Tahoma", "Verdana", "Trebuchet MS", sans-serif;
        margin: 0 auto;
        padding: 0;
        width: 90%;
}*/
.cake-sql-log {
    background: none repeat scroll 0 0 #FFFFFF;
}

a{
    font-size:12px;
    text-decoration: none;


}
a hover {
    font-size:12px;
    text-decoration: none;
}

td{
    vertical-align:top;
}

.txt1{
    width:600px;
}

.txt2{
    width:300px;
}


.txt3{
    width:100px;
}
.txt5{
    width:40px;
}
.txt6{
    width:140px;
}
form input{border: 1px solid;}
form select{width:300px;}

tr.table_header{
    background:#ccc;
    font-size:15px;
    padding:5px;
}

acronym { 
    border-style: dotted; 
    border-bottom-width:1px; 
    border-color: #FF8000; 
    border-left-width:0px; 
    border-right-width:0px; 
    border-top-width:0px; 
}
.accesskey {text-decoration: underline; }

td.td200 {width:500px;}

.table30{
    width:80%;
    padding: 15px;
}	
.table60{
    width:70%;
    padding: 15px;
}	
.table70{
    width:70%;
    padding: 15px;
}	
.table90{
    width:90%;
    padding: 15px;
}	


.error{
    color:red;
    font-size:20px;
    padding-bottom: 20px;
}
/*_______________Links_________________________*/

a:link {color:#016701; font-weight:normal; text-decoration:none; }
a:active {color:#ffff; font-weight:normal; text-decoration:none; }
a:hover {color:#016701;}
a:visited {color:#016701;}

#quickSummary a:link {color:#146d41; text-decoration:underline;background: #9ec338 }
#quickSummary a:visited {color:#146d41; text-decoration:underline; background: #9ec338}
#quickSummary a:hover {	text-decoration:none; color:#146d41; background:#9ec338}
div#error{color:red;font-weight:bold;font-size:11px;text-align: center;}
#flashMessage{
    background: #ffcc00;
    /*background-repeat: repeat-x;*/
    background-image: -moz-linear-gradient(top, #ffcc00, #E6B800);
    background-image: -ms-linear-gradient(top, #ffcc00, #E6B800);
    background-image: -webkit-gradient(linear, left top, left bottom, from(#ffcc00), to(#E6B800));
    background-image: -webkit-linear-gradient(top, #ffcc00, #E6B800);
    background-image: -o-linear-gradient(top, #ffcc00, #E6B800);
    background-image: linear-gradient(top, #ffcc00, #E6B800);
    text-shadow: 0 -1px 0 rgba(0, 0, 0, 0.25);
    border: 1px solid rgba(0, 0, 0, 0.2);
    margin-bottom: 18px;
    padding: 7px 14px;
    color: #404040;
    text-shadow: 0 1px 0 rgba(255, 255, 255, 0.5);
    -webkit-border-radius: 4px;
    -moz-border-radius: 4px;
    border-radius: 4px;
    -webkit-box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.25);
    -moz-box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.25);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.25);
}

/*__________________Headers___________________*/

#pageHeader 
{
    margin-top:1px;
    margin-left:0px;
    margin-bottom: 2px;
    margin-right:0;
    padding-top:1px;
    margin-bottom:0;
    background-position: top left; 
    background-repeat: no-repeat; 
    background-color: white;
    color:#c51b01;
}

#pageHeader a:hover {
    color:#ffffff;
    background:#ffffff;
}

#logged_id{padding:5px;background: #ddd;text-align:right;border-bottom: 2px solid #016701;}
#logged_id span{font-weight:bold;}

#login_form{
    width:450px;
    height:492px;
    text-align:centre;
    margin:0 auto;
    margin-top: 53px;
    background:transparent url('../img/loginbox.png') no-repeat;
    color:#fff;
}

input{	
    border:1px solid #ccc;
    list-style:none;
}

#topmenu{
    height:20px;
    width:100%;
    margin-top:0px;
    padding-top:3px;
    padding-bottom:3px;
    background: #016701;
    color:#fff;
    font-family:"Tahoma";
    text-shadow: 2px 2px 2px #000;
    font-size: 12px;
}

#topmenu a{
    float:left;
    padding-left:0px;
    margin-right:10px;
    background:transparent;
    color:#fff;
    font-family:"Tahoma";
    text-shadow: 2px 2px 2px #000;
    font-size: 12px;
}
#topmenu1{
    height:15px;
    width:100%;
    margin-top:0px;
    padding-top:3px;
    padding-bottom:3px;
    background:#8bc58b;
}
#topmenu12{
    float:left;
    padding-left:0px;
    margin-right:10px;
    background:transparent;
    color:#fff;
    font-family:"Tahoma";
}

#topmenu ul{
    margin-top: 0px; margin-bottom: 0px; height: 12px;padding-left:5px;
}
#topmenu ul li{float:left;list-style:none;padding-right:5px;color:#000;}

#pageHeader h1
{
    font-variant: small-caps;
    line-height: 50%;
    color:#0f1649;
    font-size:250%;
    letter-spacing: 5pt;
    word-spacing: 5pt;
    margin-bottom:0;
    margin-top:10px;
    padding-bottom: 0;
    margin-left:105px;
    font-family:  "Trebuchet MS", "arial", sans-serif;
    background-color: white;
    color:#0f1649;  letter-spacing: 1pt; word-spacing: 2pt; font-weight:bold; line-height: 250%; margin: 0 0 0 0; padding: 0 0 0 0;  text-indent:65px; background: white;

}

#pageHeader h2
{ 
    font-size:80%;
    line-height: 150%;
    color:#555555;
    letter-spacing: 3pt;
    word-spacing: 7pt;
    margin-bottom:0;
    padding-bottom: 0;
    text-indent:10px;
    margin-left:100px;
    font-family: "arial", sans-serif;
    text-transform: uppercase;
    background-color: white;
}

/*_____"A demonsration of what can be accomplished"_____*/

#quickSummary
{
    padding-left: 5px;
    padding-right: 5px;
    padding-top: 25px;
    padding-bottom: 30px;
    background:#9ec338;
    color:white;
    width:20%;
    border: solid #8cc504 0px;
    margin-top: 0%;
    margin-left:1%;
    margin-right:0%;
    margin-bottom:4%;
    line-height: 150%;
    float:left;
    clear:left;
    text-align: center;
    font-style:italic;
    letter-spacing:1px;
    font-size:100%;
    font-family: "Georgia", cursive, "Times New Roman", serif;
}

/*________"The Road to Enlightenment" & Supporting Text layout___________*/
#container{
    width: 100%; /*1200px;*/
    margin:0 auto;
    background: none repeat scroll 0 0 #fff;
}

#preamble, #supportingText {
    background:none;
    width: 100%;
    margin-right:0;
    margin-left:auto;
    line-height:150%;
    text-align: justify;
    overflow: auto;
}									
#preamble {	margin-bottom:2%}		

#supportingText {
    clear: right;
    margin-bottom: 0;
    padding: 20px;
}

#AgentEditForm label{
    width:400px;
}

/*________Preamble & Supporting Text links__________*/	


#supportingText a:active  {font-weight:normal; background:#fff; color:#5f9300;text-decoration:underline; }		
#supportingText a:hover   {font-weight:normal; background:#fff; color: #016701;text-decoration:none;}
#supportingText a:visited {font-weight:normal; background:#fff; color:#016701; text-decoration:none;}
/** #supportingText a:visited {font-weight:normal; background:#fff; color:#B55B00; text-decoration:underline;} **/

ul#rightbar{
    list-style:none;
    padding:0px;

}

ul#rightbar li{
    border-bottom:1px dotted #ccc;
    padding:5px;
}

#preamble p:first-letter {font-size: 140%;font-weight: bold;font-family:cursive;}
#explanation p:first-letter {font-size: 130%;font-weight: bold;font-family:cursive;}
#participation p:first-letter {font-size: 130%;font-weight: bold;font-family:cursive;}
#benefits p:first-letter {font-size: 130%;font-weight: bold;font-family:cursive; }
#requirements p:first-letter {font-size: 130%;font-weight: bold;font-family:cursive; }

#explanation h3{width:600px;}

/*__________Main titles________________*/		



#explanation, #participation, #benefits, #requirements
{
    margin-bottom:0; padding-bottom:2%; line-height:150%;min-height:500px;
}


#linkList
{
    width:21%; 
    float:left; line-height: 200%; 
    margin-top:0;
    margin-left:1%;
    padding-left:0%;
    font-size:85%;
    margin-right:auto;
}

#linkList li {
    border-bottom:dotted #D3D3D3 1px;
}


#linkList ul {
    list-style-type:none;
    padding:10px;
    margin:0 0 0 0; 
}	



/*_________"Select a Design"__________________*/
#lselect {

    border-style: solid;
    border-color: #3099d5;
    border-width:1px;
    padding-bottom:5px;
    /*border-top:0px;*/
}


/*_____________"Archives"_________________*/	
#larchives {

    border-style: solid;
    border-color: #3099d5;
    border-width:1px;
    margin-top:40px;
}

#larchives li {
    list-style-type: none;
}

/*_____________"Resources"_______________________*/	

#lresources {

    border-style: solid;
    border-color: #3099d5;
    border-width:1px;
    margin-top:40px;
}

.login_table{
    padding:70px;
}

/*___________Linklist_____________	

.select, .archives, .resources {
        background-color: #8ac2e3;
        color:white;
        margin: 0 0 0 0;
        padding: 0 0 0 0;
        text-indent:10px;
        letter-spacing:1px;
        border-right:none;
        border-left:none;
        border-top: solid #8ac2e3 1px;
        border-bottom: solid #8ac2e3 1px;
        font-size:100%;
                }*/	

/*___________Footer_______________*/

#footer
{
    text-align:center;
    padding-bottom:5px;
    padding-top:2px;
    margin-bottom:10px;
    border-top: 5px solid green;
}
#schooltable tr td  a{
    border: 1px solid #016701;
    padding-top: 0px;
    padding-right: 5px;
    padding-bottom: 0px;
    padding-left: 7px;
    background-color: #016701;
    font-family:"Tahoma";
    text-shadow: 1px 1px 1px #000;
    font-size: 15px;
    color: #fff;
    border-radius: 10px;
    width:80px;
    text-decoration: none;

}
.textboxlogin{
    font-size: 17px;
    color: #333333;
    background: #F7F7F7F7;
    border: 2px solid #016701;
    padding: 1px 5px;
    width: 250px;
    border-radius: 5px;
    -webkit-border-radius: 5px;
    -moz-border-radius: 5px;
    border-radius: 5px;
}
.textbox{
    font-size: 17px;
    color: #333333;
    background: #F7F7F7F7;
    border: 1px solid #CCCCCC;
    padding: 1px 5px;
    width: 300px;
    border-radius: 5px;
    -webkit-border-radius: 5px;
    -moz-border-radius: 5px;
    border-radius: 5px;
}
.textboxbreak{
    font-size: 17px;
    color: #333333;
    background: #F7F7F7F7;
    border: 1px solid #CCCCCC;
    padding: 1px 5px;
    width: 100px;
    border-radius: 5px;
    -webkit-border-radius: 5px;
    -moz-border-radius: 5px;
    border-radius: 5px;
}
/** Tables **/
table {
    border-right:0;
    clear: both;
    color: #333;
    margin-bottom: 10px;
    width: 100%;
}
th {
    border:0;
    border-bottom:2px solid #555;
    text-align: left;
    padding:4px;
}
th a {
    display: block;
    padding: 2px 4px;
    text-decoration: none;

}
th a.asc:after {
    content: ' ‚á£';
}
th a.desc:after {
    content: ' ‚á°';
}

td.actions {
    text-align: center;
    white-space: nowrap;
}
table td.actions a {
    margin: 0px 6px;
    padding:2px 5px;
}



/*DL, DT, DD TAGS LIST DATA*/
dl {
    margin-bottom:50px;
}

dl dt {
    background:#016701;
    color:#fff;
    float:left;
    font-weight:bold;
    margin-right:10px;
    padding:5px; 
    width:100px;
}

dl dd {
    margin:2px 0;
    padding:5px 0;
}

/** containers **/
#explanation div.form,
#explanation div.index,
#explanation div.view {
    float:right;
    width:80%;
}
/*#explanation div.form th,
#explanation div.index th,
#explanation div.view th{
    background-color: #9ec338;
    color: #ffffff;
    text-align: center;
    text-transform: uppercase;
    margin-top: 15px;
}*/
#explanation div.actions {
    float:left;
    width:20%;
    padding:0 1.5%;
}
#explanation div.actions h3 {
    padding-top:0;
    color:#777;
}
/**  Actions  **/
#explanation div.actions ul {
    margin: 0;
    padding: 0;
}
#explanation div.actions li {
    margin:0 0 0.5em 0;
    list-style-type: none;
    white-space: nowrap;
    padding: 0;
}
#explanation div.actions ul li a {
    font-weight: normal;
    display: block;
    clear: both;
}
#home_page{
    background: none repeat scroll 0 0 ;

    margin: auto;
    max-width: 1000px;
    min-width: 790px;
    padding: 50px;
    position: relative;
    float:left;
}

#home_page section{
    display:inline;
    float:left;
    margin: 0 1.04%;
    width:30.25%;
} 
#home_page article{
    border: 1px solid #CCCCCC;
    margin: 0 0 15px;
    padding: 20px;
    position: relative;
    border-radius: 10px;
}
article section{
    display: block;
}
.title{
    background: none repeat scroll 0 0 #146d41;
    color:#ffcc00;
    display: inline-block;
    font-size: 12px;
    line-height: 20px;
    margin: 0 0 20px;
    padding: 5px 12px 3px;
    text-transform: uppercase;
}
#explanation unza_news{
    height: 34px;
}
#explanation unza_news{
    border: 1px solid #cccccc;
    color: #ffffff;
    margin: 0 0 15px;
    overflow: hidden;
    padding: 0 0 10px;
}
#explanation unza_news h3{
    background: none repeat scroll 0 0 #146d41;
    border-right: 1px solid #cccccc;
    color:#ffffff;
    display:inline-block;
    float: left;
    line-height:  normal;
    margin: 0 10px 0 0;
    padding: 10px;
}
#explanation home_page{
    background: none repeat scroll 0 0 #ffffff;
    border-radius: 8px;
    box-shadow: 0 0 8px #666666;
    margin: auto;
    max-width: 1000px;
    min-width: 790px;
    padding: 50px;
    position: relative;
}
#explanation unza_dashboard:before,#explanation unza_dashboard:after{
    content: "";
    display: table;

}
#explanation unza_dashboard:after{
    clear: both;

}
#unza_dashboard{
    display: block;
    margin: 0 -1.04%;
    width: 102.083%;

}
article p{
    color:#333333;
    font-size: 14px;
    line-height: 23px;
    margin: 0 0 10px;
    font-family: 'OpenSansRegular';

}

/*Test css*/
/*@import url('http://fonts.googleapis.com/css?family=Cantora+One');*/

html, body, div, span, applet, object, iframe, h1, h2, h3, h4, h5, h6, p, blockquote, pre, a, abbr, acronym, address, big, cite, code, del, dfn, em, img, ins, kbd, q, s, samp, small, strike, strong, sub, sup, tt, var, b, u, i, center, dl, dt, dd, ol, ul, libg, form, label, legend, table, caption, tbody, tfoot, thead, tr, th, td, article, aside, canvas, details, embed, figure, figcaption, footer, header, hgroup, menu, nav, output, ruby, section, summary, time, mark, audio, video {
    margin: 0;
    padding: 0;
    border: 0;
    font-size: 100%;
    font: inherit;
    vertical-align: baseline;
    outline: none;
    -webkit-font-smoothing: antialiased;
    -webkit-text-size-adjust: 100%;
    -ms-text-size-adjust: 100%;
    -webkit-box-sizing: border-box;
    -moz-box-sizing: border-box;
    box-sizing: border-box;
}
html { overflow-y: scroll; }
body { 
    font-size: 62.5%; 
    line-height: 1;
    padding: 0;
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;

}

br { display: block; line-height: 1.6em; } 
img { border: 0; max-width: 100%; }

h1 {
    font-family: 'Cantora One', Arial, sans-serif;
    font-size: 3.0em;
    line-height: 1.6em;
    margin-bottom: 10px;
    color: #787878;
}

p {
    font-size: 1.4em;
    line-height: 1.25em;
    color: #575757;
    font-weight: normal;
    margin-bottom: 10px;
}

a { color: #016701; }
a:hover { color: #fff }

/* main page */
#w {
    display: block;
    width: 900px;
    margin: 0 auto;
    background: none;
}


#content {
    display: block;
    background: #fff;
    padding: 0px 15px;
    margin-left: 80px;
    -webkit-box-shadow: 1px 2px 1px rgba(0,0,0,0.4);
    -moz-box-shadow: 1px 2px 1px rgba(0,0,0,0.4);
    box-shadow: 1px 2px 1px rgba(0,0,0,0.4);
    min-height: 300px;
}


.contentblock {
    display: block;
    padding: 15px 20px;
}

.contentblock.hidden {
    display: none;
}

/* side navigation */
#sidemenu {
    margin: 0;
    padding: 0;
    width: 80px;
    float: left;
    background: #e8e8e8;
    border-right: 1px solid #c9c9c9;
}


#sidemenu li { display: block; text-align: center; border-top: 1px solid #fff; font-size: 1.1em; }

#sidemenu li a { 
    display: block;
    padding: 6px 2px;
    color: #555;
    text-decoration: none;
    border-bottom: 1px solid #d1d1d1;

}
#sidemenu li a:hover {
    background: #f2f2f2;
}

#sidemenu li a strong { 
    display: block;
    margin-top: 5px;
}

#sidemenu li a.open {
    width: 101%;
    background: #fff;
}
.related{
    float:left;
    margin-left: 15px;
}
div fieldset{
    margin: 5px;
    margin-top: 20px;
    background: none repeat scroll 0 0 #f8f8f8;
    position: relative;
    padding: 10px;
    border: 1px solid #ddd;
    box-shadow: 3px 3px 10px 1px #eee;
}

