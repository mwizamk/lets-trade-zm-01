    font-size: 13px;
    background-color: #fff;
    color: #B55B00;
    font-weight: normal;
    text-decoration: underline;
}

/* Checkbox UI */
.my_control {
    font-size: 13px;
    position: relative;
    display: block;
    padding: 10px;
    padding-left: 50px;
    cursor: pointer;
}
.my_control:hover {
    background-color: #f7f9f9;
}
.my_control input {
    position: absolute;
    z-index: -1;
    opacity: 0;
}
.my_control .my_control_ind {
    position: absolute;
    top: 11px;
    left: 25px;
    width: 16px;
    height: 16px;
    background: #ffffff;
    border: 2px solid #016701;
}
.my_control:hover input ~ .my_control_ind,
.my_control input:focus ~ .my_control_ind {
    background: #ffffff;
}
.my_control input:checked ~ .my_control_ind {
    background: #016701;
}
.my_control input:disabled ~ .my_control_ind {
    pointer-events: none;
    border: 2px solid #929292;
}
.my_control input:checked:disabled ~ .my_control_ind {
    background: #929292;
}
.my_control_ind:after {
    position: absolute;
    display: none;
    content: '';
}
.my_control input:checked ~ .my_control_ind:after {
    display: block;
}
.my_control .my_control_ind:after {
    top: 0px;
    left: 3px;
    width: 5px;
    height: 10px;
    transform: rotate(45deg);
    -webkit-transform: rotate(45deg);
    -ms-transform: rotate(45deg);
    border: solid #fff;
    border-width: 0 2px 2px 0;
}
/* /Checkbox UI */

/* Mark Ui */
.my_control .my_control_mark {
    width: 8px;
    height: 15px;
    position: absolute;
    top: 5px;
    left: 25px;
    border: solid orange;
    border-width: 0 2px 2px 0;
    transform: rotate(45deg);
}
/* /Mark Ui */

/* Radio UI*/
.program_classes {
    padding: 10px;
}
.program_classes legend {
    margin-bottom: 0px;
}
.program_classes label {
    cursor: pointer;
    font-size: 13px;
    padding: 5px;
    background-color: #eee;
    margin: 3px;
    position: relative;
}
.program_classes label:hover {
    background-color: #ddd;
}
.program_classes label input {
    position: absolute;
    z-index: -1;
    opacity: 0;
}
.program_classes label span {
    margin-left: 20px;
}
.program_classes label span:before {
    content: '';
    position: absolute;
    top: 7px;
    left: 7px;
    width: 16px;
    height: 16px;
    border: 2px solid green;
    z-index: 1;
    opacity: 1;
    border-radius: 50%;
    -webkit-border-radius: 50%;
    -moz-border-radius: 50%;
}
.program_classes label input:checked ~ span:after {
    content: '';
    position: absolute;
    top: 11px;
    left: 11px;
    width: 8px;
    height: 8px;
    background-color: green;
    z-index: 1;
    opacity: 1;
    border-radius: 50%;
    -webkit-border-radius: 50%;
    -moz-border-radius: 50%;
}
/* /Radio Ui */

.session_courses {
    font-size: 11px;
    border-collapse: collapse;
    border-spacing: 0;
}
.session_courses tr:hover{
    background-color: #eee;
}
.session_courses tr th,
.session_courses tr td {
    border: 1px solid #ccc;
    padding: 2px;
}
.fa, .glyphicon {
    margin-right: 5px;
}
.loginBlock {
    margin-top: 20px;
}
.loginBlock .input-group-addon {
    width: 40px;
}

/* NAVBAR */
.navbar.navbar-green {
    border-radius: 0 !important;
}
.navbar-green {
    background-color: #016701;
    border-color: #016701;
}
.navbar-green .navbar-header .navbar-brand {
    padding: 2px 10px;
}
.navbar-green .navbar-header .navbar-brand img {
    padding: 0;
    height: 100%;
    float: left;
}
.navbar-green .navbar-header .navbar-brand span {
    color: #fff;
    line-height: 50px;
    padding: 0 10px;
}
.navbar-green .navbar-nav>li>a {
    color: #fff;
}
.navbar-green .navbar-nav>.open>a, .navbar-green .navbar-nav>.open>a:focus, .navbar-green .navbar-nav>.open>a:hover {
    color: #fa0;
    background-color: #005700 !important;
}
.navbar-green .navbar-toggle .icon-bar {
    background-color: #fff;
}
@media (max-width: 767px) {
    .navbar-green .navbar-nav .open .dropdown-menu .dropdown-header, .navbar-green .navbar-nav .open .dropdown-menu > li > a {
        color: #fff;
    }
    .navbar-green .navbar-nav .open .dropdown-menu>li>a:focus, .navbar-green .navbar-nav .open .dropdown-menu>li>a:hover {
        background-color: #005700;
    }
}
.nav>li>a:focus, .nav>li>a:hover {
    text-decoration: none;
    background-color: inherit !important;
}
.sidebar {
    height: 800px;
}
.sidebar .content {
    background-color: #eee;
}
.sidebar {
    width: 16.666667%;
    position: fixed;
    top: 50px;
    background-color: #eee;
    margin-left: -15px;
}
.sidebar ul {
    margin-top: 30px;
}
.sidebar ul li a {
    padding: 6px 10px;
    display: block;
}
.sidebar ul li a:hover, .sidebar ul li a:active {
    text-decoration: none;
    background-color: #ddd;
    border-right: 3px solid #fa0;
}
.sidebar ul li a i {
    width: 20px;
}



/* Sexual Harassment CSS Start*/

.blur-it_survey {
   -webkit-filter: blur(4px);
    filter: blur(4px);
}


.modal-wrapper_survey {

    visibility: hidden;
    opacity: 0;
    -webkit-transition: all 0.25s ease-in-out;
    transition: all 0.25s ease-in-out;
}

.modal-wrapper_survey.open {
    opacity: 1;
    visibility: visible;
}

.modal_survey {
    width: 280px;
    height: 220px;
    display: block;
    margin: -220px 0 0 -300px;
    position: relative;
    left: 100%;
    bottom: 250px;

    background: #ffe494;
    opacity: 0;
    -webkit-transition: all 0.5s ease-in-out;
    transition: all 0.5s ease-in-out;
}

.modal-wrapper_survey.open .modal_survey {
    margin-top: -220px;
    opacity: 1;
}

.head_survey {
    width: 100%;
    height: 55px;
    padding: 12px 30px;
    overflow: hidden;
    color: #fff;
    background: #016701;
    font-weight: 700;
}

.btn-close_survey {
    font-size: 20px;
    display: block;
    float: right;
    color: #fff;
}

.content_survey {
    padding: 10%;
}

.good-job {
    text-align: center;
    font-family: 'Montserrat', Arial,       Helvetica, sans-serif;
    color: red;
    font-weight: 600;
}
.good-job .fa-thumbs-o-up {
    font-size: 20px;
}
.good-job h1 {
    font-size: 20px;
}
